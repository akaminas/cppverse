{
  "name": "cppverse",
  "description": "C++ Atlas — Programming and Modelling for Biologists",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node --experimental-strip-types scripts/validate-curriculum.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cpp:benchmarks": "node --experimental-strip-types scripts/write-benchmarks.ts"
  },
