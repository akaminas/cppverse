    "@types/d3-shape": "3.2.0",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
