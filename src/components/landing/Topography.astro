---
import { topoMap } from '../../lib/topo';
const map = topoMap();
---
<div class="topo" aria-hidden="true">
  <svg viewBox={`0 0 ${map.width} ${map.height}`} preserveAspectRatio="xMidYMid slice">
    {map.paths.map((p) => <path d={p.d} class:list={{ index: p.index }} />)}
  </svg>
</div>
<style>
  .topo { position: absolute; inset: -4%; overflow: hidden; pointer-events: none; }
  .topo svg { width: 100%; height: 100%; display: block; animation: drift 90s ease-in-out infinite alternate; transform-origin: 60% 50%; }
  .topo path { fill: none; stroke: var(--v-grid); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .topo path.index { stroke: var(--v-rule); stroke-opacity: 0.55; }
  @keyframes drift {
    from { transform: translate3d(0, 0, 0) scale(1.02); }
    to { transform: translate3d(-1.6%, 1.1%, 0) scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) { .topo svg { animation: none; } }
</style>
