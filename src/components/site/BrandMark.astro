---
// A nautilus spiral drawn in pixels: a squared spiral on a 5 × 5 grid,
// traced from the outer whorl inwards and brightening as it coils, ending in
// a round terracotta pearl at its heart. public/favicon.svg is the same drawing
// (regenerate it with scripts/brand-favicon.mjs after a change here).
const PATH: [number, number][] = [];
const run = (r: number, c: number, dr: number, dc: number, n: number) => {
  for (let i = 0; i < n; i++) PATH.push([r + dr * i, c + dc * i]);
};
run(0, 0, 0, 1, 5); // top, left to right
run(1, 4, 1, 0, 4); // right side, down
run(4, 3, 0, -1, 4); // bottom, right to left
run(3, 0, -1, 0, 2); // left side, up
run(2, 1, 0, 1, 1); // into the centre
const PEARL: [number, number] = [2, 2];
const CELL = 5.8;
const SIZE = 4.6;
const at = (n: number) => 1.5 + n * CELL + (CELL - SIZE) / 2;
const opacity = (i: number) => (0.38 + 0.62 * (i / (PATH.length - 1)) ** 1.3).toFixed(2);
---
<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
  {PATH.map(([r, c], i) => (
    <rect x={at(c).toFixed(2)} y={at(r).toFixed(2)} width={SIZE} height={SIZE} rx="1" fill="var(--accent)" fill-opacity={opacity(i)} />
  ))}
  <circle cx={(at(PEARL[1]) + SIZE / 2).toFixed(2)} cy={(at(PEARL[0]) + SIZE / 2).toFixed(2)} r={SIZE / 2} fill="var(--p-terracotta)" />
</svg>
