---
// The nautilus companion (see nautilus.ts). The shell is a true logarithmic
// spiral, r = a·e^(bθ), computed here at build time; its last whorl is the
// outline, ending in the aperture where the hood and tentacles emerge.
import { getCollection } from 'astro:content';
import { lessonCheckCounts } from '../../lib/atlas-data';
import { url } from '../../lib/url';

// Every required lesson and its number of checks: the nautilus offers the
// deep trial once each is studied or demonstrated.
const checkCounts = lessonCheckCounts();
const required = (await getCollection('lessons')).filter((e) => !e.data.optional).map((e) => [e.id, checkCounts[e.id] ?? 0]);

// The dive: bubbles rising and ripples spreading, placed by a fixed
// pseudo-random sequence so every page renders the same markup.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const bubbles = Array.from({ length: 30 }, () => ({
  x: (4 + 92 * rand()).toFixed(1),
  s: (5 + 22 * rand() ** 2).toFixed(1),
  t: (1.5 + 1.3 * rand()).toFixed(2),
  d: (0.9 * rand()).toFixed(2),
  w: ((rand() - 0.5) * 60).toFixed(0),
}));
const ripples = Array.from({ length: 6 }, (_, i) => ({ x: (12 + 76 * rand()).toFixed(1), y: (14 + 50 * rand()).toFixed(1), d: (i * 0.22).toFixed(2) }));
const a = 1.55;
const b = 0.205;
const cx = 10;
const cy = 0;
const end = 0.88 * Math.PI; // aperture faces left and slightly down
const phi = end - 4 * Math.PI;
const pt = (t: number) => {
  const r = a * Math.exp(b * t);
  return [cx + r * Math.cos(t + phi), cy + r * Math.sin(t + phi)] as const;
};
const path = (t0: number, t1: number, n = 90) =>
  Array.from({ length: n + 1 }, (_, i) => {
    const [x, y] = pt(t0 + ((t1 - t0) * i) / n);
    return `${i ? 'L' : 'M'}${x.toFixed(2)},${y.toFixed(2)}`;
  }).join('');
const shell = `${path(2 * Math.PI, 4 * Math.PI)}Z`;
const coil = path(0.6 * Math.PI, 2.6 * Math.PI, 50);
// Tiger stripes on the back of the shell: wavy rays from the coil to the rim.
const stripes = Array.from({ length: 7 }, (_, i) => {
  const t = 2 * Math.PI + 0.55 + i * 0.62;
  const [x1, y1] = pt(t - 2 * Math.PI);
  const [x2, y2] = pt(t);
  const mx = (x1 + x2) / 2 + (y2 - y1) * 0.12;
  const my = (y1 + y2) / 2 - (x2 - x1) * 0.12;
  return `M${x1.toFixed(2)},${y1.toFixed(2)}Q${mx.toFixed(2)},${my.toFixed(2)} ${x2.toFixed(2)},${y2.toFixed(2)}`;
});
const [ox, oy] = pt(4 * Math.PI);
const [ix, iy] = pt(2 * Math.PI);
const tentacles = [
  { y: 0, len: 29 },
  { y: 2, len: 35 },
  { y: 4, len: 32 },
  { y: 6, len: 38 },
  { y: 7.5, len: 31 },
  { y: 8.5, len: 27 },
];
---
<div class="nautilus-root" data-nautilus data-lessons={JSON.stringify(required)} data-deep={url('/deep/')}>
  <div class="nautilus-layer" aria-hidden="true">
    <svg class="nautilus-trail"><polyline points="" /></svg>
    <div class="nautilus">
      <div class="nautilus-flip">
        <svg viewBox="-46 -26 80 52" width="64" height="42">
          <defs>
            <clipPath id="nt-shell-clip"><path d={shell} /></clipPath>
            <radialGradient id="nt-shell-shade" cx="0.62" cy="0.38" r="0.75">
              <stop offset="0" style="stop-color: var(--nt-shell-a)" />
              
              <stop offset="1" style="stop-color: var(--nt-shell-b)" />
            </radialGradient>
          </defs>
          <g class="nt-tentacles">
            {tentacles.map((t) => <path class="nt-tentacle" data-y={t.y} data-len={t.len} d={`M-8,${t.y} L${-8 - t.len},${t.y}`} />)}
          </g>
          <path class="nt-shell" d={shell} fill="url(#nt-shell-shade)" />
          <g clip-path="url(#nt-shell-clip)">
            {stripes.map((d) => <path class="nt-stripe" d={d} />)}
          </g>
          <path class="nt-coil" d={coil} />
          <circle class="nt-umbilicus" cx={cx} cy={cy} r="2.2" />
          <path class="nt-hood" d={`M${(ox + 3).toFixed(2)},${(oy - 1).toFixed(2)} C${(ox - 7).toFixed(2)},${(oy - 5).toFixed(2)} -16,${(iy - 6).toFixed(2)} ${(ix - 1).toFixed(2)},${(iy - 3).toFixed(2)} C${(ix - 2).toFixed(2)},${(iy + 3).toFixed(2)} -10,10 -14,9 C-16,4 -16,-2 ${(ox + 3).toFixed(2)},${(oy - 1).toFixed(2)}Z`} />
          <circle class="nt-spot" cx="-11" cy="5.6" r="0.8" />
          <circle class="nt-spot" cx="-9.4" cy="7.6" r="0.6" />
          <circle class="nt-spot" cx="-2.6" cy="3.6" r="0.6" />
          <circle class="nt-eye" cx="-6.4" cy="3.1" r="2" />
          <circle class="nt-glint" cx="-7" cy="2.5" r="0.6" />
          <g class="nt-crown" transform="rotate(-14 -9 -2)">
            <path class="nt-crown-band" d="M-13.4,-1.6 L-14.2,-7.4 L-11.4,-4.6 L-9.1,-9.2 L-6.8,-4.6 L-4,-7.4 L-4.8,-1.6 Z" />
            <path class="nt-crown-rim" d="M-13.3,-2.6 L-4.9,-2.6" />
            <circle class="nt-crown-gem" cx="-14.2" cy="-7.6" r="0.75" />
            <circle class="nt-crown-gem is-centre" cx="-9.1" cy="-9.5" r="0.95" />
            <circle class="nt-crown-gem" cx="-4" cy="-7.6" r="0.75" />
          </g>
        </svg>
      </div>
    </div>
  </div>
  <div class="nautilus-bubble" hidden>
    <p class="nb-kind"></p>
    <p class="nb-text"></p>
    <div class="nb-actions">
      <a class="btn nb-link" href="#" hidden></a>
      <button type="button" class="btn nb-ok">Thanks</button>
      <button type="button" class="btn btn-ghost nb-mute">Mute tips</button>
    </div>
  </div>
  <p class="sr-only nb-live" aria-live="polite"></p>
  <div class="nautilus-dive" aria-hidden="true">
    {ripples.map((r) => <span class="nd-ripple" style={`--x:${r.x}%;--y:${r.y}%;--d:${r.d}s`} />)}
    {bubbles.map((b) => <span class="nd-bubble" style={`--x:${b.x}%;--s:${b.s}px;--t:${b.t}s;--d:${b.d}s;--w:${b.w}px`} />)}
  </div>
</div>

<script>
  import { startNautilus } from './nautilus';
  const root = document.querySelector<HTMLElement>('[data-nautilus]');
  if (root) startNautilus(root);
</script>

<style>
  .nautilus-layer { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .nautilus-root.is-present .nautilus-layer { z-index: 70; }
  .nautilus-trail { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nautilus-trail polyline { fill: none; stroke: #6FE3EE; stroke-opacity: 0.12; stroke-width: 1; stroke-dasharray: 2 4; }
  .nautilus {
    /* Muted greys while it drifts behind the page; true colours when it comes forward. */
    --nt-shell-a: #9A9EA5; --nt-shell-b: #6E737B; --nt-line: #50555D; --nt-stripe: #5D6168;
    --nt-hood: #3E4248; --nt-spot: #8C9097; --nt-arm: #7E838B;
    --nt-crown: #A29D8F; --nt-crown-line: #5E5A52; --nt-gem: #7E838B;
    position: absolute; left: 0; top: 0; width: 64px; height: 42px; margin: -21px 0 0 -36.8px;
    transform-origin: 36.8px 21px; will-change: transform;
    opacity: 0.22; transition: opacity 0.8s ease;
  }
  .nautilus-flip { width: 100%; height: 100%; transform-origin: 36.8px 21px; }
  .nautilus svg { display: block; overflow: visible; }
  .nautilus-root.is-present .nautilus {
    --nt-shell-a: #FFF8EC; --nt-shell-b: #C9B49A; --nt-line: #8C6B4E; --nt-stripe: #B5602F;
    --nt-hood: #6A5249; --nt-spot: #EFE3D3; --nt-arm: #D9B9A2;
    --nt-crown: #EBC867; --nt-crown-line: #8A6420; --nt-gem: #E8C0B2;
    opacity: 1; filter: drop-shadow(0 0 10px rgba(111, 227, 238, 0.35));
  }
  .nt-shell { stroke: var(--nt-line); stroke-width: 0.6; }
  .nt-stripe { fill: none; stroke: var(--nt-stripe); stroke-width: 2.1; stroke-linecap: round; opacity: 0.85; }
  .nt-coil { fill: none; stroke: var(--nt-line); stroke-width: 0.6; opacity: 0.7; }
  .nt-umbilicus { fill: var(--nt-hood); }
  .nt-hood { fill: var(--nt-hood); stroke: #2A2420; stroke-width: 0.5; }
  .nt-spot { fill: var(--nt-spot); opacity: 0.8; }
  .nt-eye { fill: #121212; stroke: #2A211D; stroke-width: 0.4; }
  .nt-glint { fill: #fff; }
  .nt-tentacle { fill: none; stroke: var(--nt-arm); stroke-width: 1.3; stroke-linecap: round; }
  /* The crown of the deep trial: worn for good once the lake passes every check. */
  .nt-crown { display: none; }
  .nautilus-root.is-crowned .nt-crown { display: inline; }
  .nt-crown-band { fill: var(--nt-crown); stroke: var(--nt-crown-line); stroke-width: 0.45; stroke-linejoin: round; }
  .nt-crown-rim { fill: none; stroke: var(--nt-crown-line); stroke-width: 0.4; opacity: 0.8; }
  .nt-crown-gem { fill: var(--nt-gem); stroke: var(--nt-crown-line); stroke-width: 0.3; }
  .nautilus-root.is-present .nt-crown-gem.is-centre { fill: #A5D5D7; }

  /* The dive: the page sinks into dark water as bubbles rise past and the
     surface rings out. Arriving in the deep, the water clears again. */
  .nautilus-dive {
    position: fixed; inset: 0; z-index: 69; pointer-events: none; overflow: hidden; display: none;
    background: linear-gradient(180deg, rgba(6, 30, 36, 0) 0%, rgba(5, 26, 32, 0.55) 30%, rgba(3, 15, 19, 0.94) 62%, #01080b 100%);
    background-size: 100% 320%;
  }
  .nautilus-root.is-diving .nautilus-dive { display: block; animation: nd-sink 2.6s cubic-bezier(0.5, 0, 0.75, 0.6) forwards; }
  .nautilus-root.is-arriving .nautilus-dive { display: block; background: #01080b; animation: nd-clear 1.8s ease-out forwards; }
  @keyframes nd-sink { from { background-position: 0 0; } to { background-position: 0 100%; } }
  @keyframes nd-clear { from { opacity: 1; } to { opacity: 0; } }
  .nd-bubble {
    position: absolute; left: var(--x); bottom: -40px; width: var(--s); height: var(--s); border-radius: 50%;
    border: 1px solid rgba(165, 213, 215, 0.5);
    background: radial-gradient(circle at 32% 30%, rgba(255, 255, 255, 0.55), rgba(165, 213, 215, 0.1) 45%, transparent 72%);
    animation: nd-rise var(--t) cubic-bezier(0.3, 0.1, 0.6, 1) var(--d) both;
  }
  .nautilus-root.is-arriving .nd-bubble { animation-delay: calc(var(--d) * 0.4); }
  @keyframes nd-rise {
    0% { transform: translate(0, 0); }
    50% { transform: translate(var(--w), -55vh); }
    100% { transform: translate(0, -118vh); }
  }
  .nd-ripple {
    position: absolute; left: var(--x); top: var(--y); width: 24px; height: 24px; margin: -12px; border-radius: 50%;
    border: 1px solid rgba(165, 213, 215, 0.6); opacity: 0;
    animation: nd-ripple 1.9s ease-out var(--d) both;
  }
  .nautilus-root.is-arriving .nd-ripple { display: none; }
  @keyframes nd-ripple {
    0% { transform: scale(0.2, 0.07); opacity: 0.9; }
    100% { transform: scale(16, 5); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nd-bubble, .nd-ripple { display: none; }
    .nautilus-root.is-diving .nautilus-dive { background: #01080b; animation: nd-darken 0.6s ease forwards; }
    @keyframes nd-darken { from { opacity: 0; } to { opacity: 1; } }
  }

  .nautilus-bubble {
    position: fixed; z-index: 71; right: 220px; bottom: 96px; width: min(340px, calc(100vw - 32px));
    background: rgba(12, 19, 22, 0.94); color: var(--v-ink); border: 1px solid #1F3A40; border-radius: 16px 16px 4px 16px;
    padding: 14px 16px 12px; box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(111, 227, 238, 0.06), 0 0 28px rgba(111, 227, 238, 0.12);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    animation: nb-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nautilus-bubble[hidden] { display: none; }
  .nautilus-bubble[data-kind='cheer'] { border-color: #2E5A3A; }
  .nautilus-bubble[data-kind='break'] { border-color: #5A4A24; }
  .nautilus-bubble[data-kind='spur'] { border-color: #2E5A3A; }
  .nautilus-bubble[data-kind='spur'] .nb-kind { color: var(--v-status-good); }
  .nautilus-bubble[data-kind='pointer'] { border-color: #2F4A66; }
  .nautilus-bubble[data-kind='pointer'] .nb-kind { color: var(--p-indigo); }
  .nb-kind { margin: 0 0 4px; font-family: var(--v-font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .nautilus-bubble[data-kind='cheer'] .nb-kind { color: var(--v-status-good); }
  .nautilus-bubble[data-kind='break'] .nb-kind { color: var(--v-status-warning); }
  .nautilus-bubble[data-kind='quest'] { border-color: #5C5236; box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.9), 0 0 32px rgba(218, 201, 166, 0.16); }
  .nautilus-bubble[data-kind='quest'] .nb-kind { color: var(--p-ochre); }
  /* Tip voices: the heading takes the colour, the border follows faintly. */
  .nautilus-bubble[data-voice='disaster'] { border-color: #5A3A2A; }
  .nautilus-bubble[data-voice='disaster'] .nb-kind { color: var(--v-status-serious); }
  .nautilus-bubble[data-voice='shortcut'] .nb-kind { color: var(--v-status-warning); }
  .nautilus-bubble[data-voice='field'] .nb-kind { color: var(--v-moss); }
  .nautilus-bubble[data-voice='style'] .nb-kind { color: var(--v-mauve); }
  .nautilus-bubble[data-voice='deep'] .nb-kind { color: var(--v-indigo); }
  .nb-text { margin: 0 0 12px; font-size: 0.95rem; line-height: 1.5; }
  .nb-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .nb-actions .btn { font-size: 0.82rem; padding: 5px 12px; }
  .nb-actions [hidden] { display: none; }
  .nb-link { text-decoration: none; }
  /* A slide without a fade: the text keeps full contrast from the first frame. */
  @keyframes nb-in { from { transform: translateY(10px) scale(0.97); } }
  @media (max-width: 620px) {
    .nautilus-bubble { right: 16px; bottom: 236px; border-radius: 16px; }
  }
</style>
