---
// Resolves the theme before the first paint (the saved choice, else the system
// setting) and exposes window.cppTheme for the toggle button. Inline, so there is
// no flash of the wrong theme. Both layouts put this in <head>, after the
// <meta name="theme-color"> tag.
---
<script is:inline>
  (function () {
    var KEY = 'cpp-atlas:theme';
    var root = document.documentElement;
    // The browser-bar colour of each theme: the page background.
    var BAR = root.hasAttribute('data-stage') ? { light: '#f7f8fa', dark: '#0a0b0d' } : { light: '#ffffff', dark: '#15181d' };
    var dark = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

    function stored() {
      try {
        var t = localStorage.getItem(KEY);
        return t === 'light' || t === 'dark' ? t : null;
      } catch (e) {
        return null;
      }
    }
    function apply(theme) {
      root.setAttribute('data-theme', theme);
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', BAR[theme]);
    }
    apply(stored() || (dark && dark.matches ? 'dark' : 'light'));

    // Without a saved choice the page follows the system setting as it changes.
    if (dark && dark.addEventListener) {
      dark.addEventListener('change', function (e) {
        if (!stored()) apply(e.matches ? 'dark' : 'light');
      });
    }
    window.cppTheme = {
      current: function () {
        return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      },
      set: function (theme) {
        try {
          localStorage.setItem(KEY, theme);
        } catch (e) {
          /* private mode: the choice lasts for this page only */
        }
        apply(theme);
      },
    };
  })();
</script>
