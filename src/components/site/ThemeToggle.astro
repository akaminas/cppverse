---
// The header button that switches between the light and the dark theme. It shows
// the icon of the theme it would switch to.
---
<button class="icon-btn theme-btn" type="button" aria-label="Switch to the dark theme" title="Switch to the dark theme">
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2z" /></svg>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
  </svg>
</button>

<script>
  type ThemeApi = { current(): 'light' | 'dark'; set(theme: 'light' | 'dark'): void };
  const api = (window as unknown as { cppTheme?: ThemeApi }).cppTheme;
  const button = document.querySelector<HTMLButtonElement>('.theme-btn');
  const label = () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    button?.setAttribute('aria-label', `Switch to the ${next} theme`);
    button?.setAttribute('title', `Switch to the ${next} theme`);
  };
  label();
  // The label follows the theme however it changed (the button, or the system setting).
  new MutationObserver(label).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  button?.addEventListener('click', () => api?.set(api.current() === 'dark' ? 'light' : 'dark'));
</script>

<style>
  .theme-btn .icon-sun { display: none; }
  :global(:root[data-theme='dark']) .theme-btn .icon-sun { display: block; }
  :global(:root[data-theme='dark']) .theme-btn .icon-moon { display: none; }
</style>
