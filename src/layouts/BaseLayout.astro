---
import '../styles/global.css';
import BrandMark from '../components/site/BrandMark.astro';
import Attribution from '../components/site/Attribution.astro';
import Nautilus from '../components/site/Nautilus.astro';
import ThemeInit from '../components/site/ThemeInit.astro';
import ThemeToggle from '../components/site/ThemeToggle.astro';
import { url } from '../lib/url';
import { NAV, type Section } from './nav';

interface Props {
  title: string;
  description?: string;
  /** Section of the site for aria-current in the navigation. */
  section?: Section;
  bodyClass?: string;
}

const { title, description = 'Learn C++ and use it to build and understand models of biological systems.', section, bodyClass } = Astro.props;
const fullTitle = `${title} · C++ Atlas`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <ThemeInit />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to the content</a>
    <header class="site-header">
      <div class="wrap header-in">
        <a class="brand" href={url('/')} aria-label="C++ Atlas home">
          <BrandMark />
          <span class="brand-word">C++ Atlas</span>
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          {NAV.map((item) => (
            <a href={item.href} aria-current={section === item.id ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <ThemeToggle />
          <button class="icon-btn menu-btn" type="button" aria-label="Open the menu" aria-expanded="false" aria-controls="site-nav">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <Nautilus />

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <Attribution />
          <p>
            C++ Atlas is an independent educational project. It is not an official University of Groningen course and is
            not endorsed by the University. Assignments, exercise solutions and graded projects from the course manual are
            not reproduced.
          </p>
          <p>Scientific figures follow the <a href="https://akaminas.github.io/vellum/">Vellum</a> design system.</p>
        </div>
        <div class="footer-links">
          <a href={url('/sources/')}>Sources</a>
          <a href={url('/about/')}>About</a>
          <a href={url('/curriculum/')}>Curriculum outline</a>
          <a href={url('/capstones/')}>Capstones</a>
        </div>
      </div>
    </footer>

    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-btn');
      const nav = document.getElementById('site-nav');
      menu?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        menu.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
      });
    </script>
  </body>
</html>
