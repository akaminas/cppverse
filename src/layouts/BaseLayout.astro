---
import '../styles/global.css';
import BrandMark from '../components/site/BrandMark.astro';
import Attribution from '../components/site/Attribution.astro';
import Nautilus from '../components/site/Nautilus.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Section of the site for aria-current in the navigation. */
  section?: 'atlas' | 'curriculum' | 'models' | 'pathways' | 'progress' | 'about' | 'learn' | 'start' | 'capstones';
  /** Landing page: transparent header, no footer chrome. */
  bare?: boolean;
  /** Full-viewport application pages (the atlas): no footer. */
  app?: boolean;
  bodyClass?: string;
}

const { title, description = 'Learn the language. Build the model. Understand the system.', section, bare = false, app = false, bodyClass } = Astro.props;
const fullTitle = title === 'C++ Atlas' ? 'C++ Atlas — Programming and Modelling for Biologists' : `${title} · C++ Atlas`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { id: 'atlas', href: url('/atlas/'), label: 'Atlas' },
  { id: 'curriculum', href: url('/curriculum/'), label: 'Curriculum' },
  { id: 'models', href: url('/models/'), label: 'Destinations' },
  { id: 'pathways', href: url('/pathways/'), label: 'Pathways' },
  { id: 'progress', href: url('/progress/'), label: 'Progress' },
  { id: 'about', href: url('/about/'), label: 'About' },
] as const;
---
<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0B0D" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to the content</a>
    <header class:list={['site-header', { 'is-transparent': bare }]}>
      <div class="wrap header-in">
        <a class="brand" href={url('/')} aria-label="C++ Atlas home">
          <BrandMark />
          <span class="brand-word">C++ Atlas</span>
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={section === item.id ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <button class="icon-btn menu-btn" type="button" aria-label="Open the menu" aria-expanded="false" aria-controls="site-nav">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <slot />
    </main>

    {!bare && <Nautilus />}

    {!bare && !app && (
      <footer class="site-footer">
        <div class="wrap">
          <div>
            <Attribution />
            <p>
              C++ Atlas is an independent educational project. It is not an official University of Groningen course and is
              not endorsed by the University. Assignments, exercise solutions and graded projects from the course manual are
              not reproduced.
            </p>
            <p>Figures and colour follow the <a href="https://akaminas.github.io/vellum/">Vellum</a> design system.</p>
          </div>
          <div class="footer-links">
            <a href={url('/sources/')}>Sources</a>
            <a href={url('/about/')}>About</a>
            <a href={url('/curriculum/')}>Curriculum outline</a>
            <a href={url('/capstones/')}>Capstones</a>
          </div>
        </div>
      </footer>
    )}

    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-btn');
      const nav = document.getElementById('site-nav');
      menu?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        menu.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
      });
    </script>
  </body>
</html>
