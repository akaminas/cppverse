---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import { lessonComponents } from '../../components/lessons/mdx-components';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'lessons'> }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<LessonLayout entry={entry} headings={headings}>
  <Content components={lessonComponents} />
</LessonLayout>
