---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteBox from '../components/progress/RouteBox';
import { goals } from '../data/goals';
import { conceptById } from '../data/concepts';
import { lessonCheckCounts } from '../lib/atlas-data';
import { hrefFor } from '../lib/lesson-context';
import { url } from '../lib/url';
const checkCounts = lessonCheckCounts();
---
<BaseLayout title="Pathways" section="pathways" description="Goal-based routes through the atlas, computed from the prerequisites of each concept.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Pathways</p>
      <h1>Routes to what you want to build</h1>
      <p class="lead">
        Each pathway is the set of concepts its goal depends on, in prerequisite order. Your level and your progress decide which
        steps are already covered. Open a pathway in the <a href={url('/atlas/')}>atlas</a> to see it on the map.
      </p>
    </header>
    <div class="pw-list">
      {goals.map((g) => (
        <section class="pw" aria-labelledby={`pw-${g.id}`}>
          <div class="pw-head">
            <h2 id={`pw-${g.id}`}>{g.title}</h2>
            <p class="muted">{g.summary}</p>
            <p class="pw-targets">
              Ends with {g.targets.map((t, i) => (<>{i > 0 && ', '}<a href={hrefFor(conceptById[t])}>{conceptById[t].title}</a></>))}
              {' · '}<a href={url(`/atlas/?goal=${g.id}`)}>Show in the atlas</a>
            </p>
          </div>
          <RouteBox client:visible targets={g.targets} base={import.meta.env.BASE_URL} checkCounts={checkCounts} limit={6} />
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
<style>
  .pw-list { display: grid; gap: 40px; }
  .pw { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 28px; padding-top: 22px; border-top: 1px solid var(--v-ink); }
  @media (max-width: 860px) { .pw { grid-template-columns: minmax(0, 1fr); } }
  .pw h2 { font-size: 1.55rem; }
  .pw-targets { font-size: 0.9rem; }
</style>
