---
// Pathways and destinations were one idea on two pages. Goals now live with the destinations
// they lead to; this page only forwards old links.
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
const target = url('/models/');
---
<BaseLayout title="Destinations" section="models" description="Goals and destinations now share one page.">
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
  </Fragment>
  <div class="wrap-narrow">
    <header class="page-head">
      <h1>This page has moved</h1>
    </header>
    <p>Goals and destinations are now on one page: <a href={target}>choose what you want to learn</a>.</p>
  </div>
</BaseLayout>
