---
import BaseLayout from '../layouts/BaseLayout.astro';
import Attribution from '../components/site/Attribution.astro';
import { CITATION, MANUAL } from '../data/citation';
import { url } from '../lib/url';
---
<BaseLayout title="Sources" section="about" description="Sources, required attribution and content-use rules.">
  <div class="wrap">
    <header class="page-head">
      <h1>Sources</h1>
    </header>

    <section class="src-section" aria-labelledby="primary">
      <div class="sec-head"><h2 id="primary">Primary source</h2></div>
      <div class="measure">
        <p>
          The curriculum follows <cite>{MANUAL.title}</cite> by {MANUAL.authors.join(', ')} ({MANUAL.institution}). It sets the
          C++ knowledge taught here, the order of the concepts and the four modelling destinations.
        </p>
        <div class="key"><Attribution label="Required attribution" /></div>
        <p>
          C++ Atlas is an independent educational project. Its lessons, examples, figures, laboratories and exercises are written
          from scratch, and it is not endorsed by the source's authors.
        </p>
      </div>
    </section>

    <section class="src-section" aria-labelledby="supporting">
      <div class="sec-head"><h2 id="supporting">Supporting sources</h2></div>
      <ul class="measure">
        <li><cite>Mastering Modern C++23: A Complete Guide to the Latest Standard</cite>: used for modern syntax, safer idioms and compiler-support notes. The examples are written for C++23, and newer C++26 features are labelled as such.</li>
        <li><cite>Modern C++ in the Real World</cite>: used for software-engineering practice that matters for scientific models (organisation, testing, debugging, profiling, reproducibility).</li>
        <li><a href="https://en.cppreference.com/">cppreference.com</a>: the reference for language and library behaviour.</li>
        <li><a href="https://isocpp.org/">isocpp.org</a>: news on the C++26 standard and on compiler support.</li>
        <li><a href="https://akaminas.github.io/vellum/">Vellum</a>: the design system for colour, typography and every scientific figure (MIT-licensed code; tokens copied verbatim).</li>
      </ul>
    </section>

    <section class="src-section" aria-labelledby="licences">
      <div class="sec-head"><h2 id="licences">Licences</h2></div>
      <ul class="measure">
        <li>Vellum tokens and code: MIT licence, © 2026 Alexandros Kaminas.</li>
        <li>
          Fonts, self-hosted: Carlito (<a href={url('/fonts/OFL-Carlito.txt')}>SIL Open Font License 1.1</a>), an open font with the same metrics as Calibri, and Source Code Pro
          (<a href={url('/fonts/OFL-SourceCode.txt')}>SIL Open Font License 1.1</a>); on the landing page and the atlas also TeX Gyre Pagella
          (<a href={url('/fonts/GUST-FONT-LICENSE.txt')}>GUST Font License</a>) and Lato (<a href={url('/fonts/OFL-Lato.txt')}>SIL Open Font License 1.1</a>).
        </li>
        <li>Curriculum source: {CITATION}.</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .src-section { margin-top: 56px; }
  .src-section h3 { margin-top: 1.4em; }
</style>
